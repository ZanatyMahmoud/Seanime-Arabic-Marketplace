{
  "id": "arabic-anime4up",
  "name": "Anime4Up",
  "description": "Arabic anime streaming provider for Seanime (Anime4Up).",
  "version": "0.1.1",
  "author": "ZanatyMahmoud",
  "type": "onlinestream-provider",
  "language": "typescript",
  "lang": "ar",
  "manifestURI": "https://raw.githubusercontent.com/ZanatyMahmoud/Seanime-Arabic-Marketplace/main/src/online-streaming/Anime4Up/manifest.json",
  "payloadURI": "https://raw.githubusercontent.com/ZanatyMahmoud/Seanime-Arabic-Marketplace/main/dist/Anime4Up/provider.ts",
  "workingTag": false,
  "brokenTag": false,
  "deprecatedTag": false,
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "baseUrl",
        "label": "Base URL",
        "type": "text",
        "default": "https://w1.anime4up.rest"
      }
    ]
  },
  "metadata": {
    "fallbackDomains": [
      "https://w1.anime4up.rest"
    ],
    "verification": "unverified-until-live-stream-test"
  }
}
